# Copy to .env and fill in your own key. Never share or commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-2
PORT=8787
CLOSET_OWNER_EMAIL=
# Leave these empty for local testing. Set them only on your HTTPS host.
PUBLIC_ORIGIN=
PILOT_CODE=
DATA_DIR=
# Per-account daily AI request cap; this is not a monetary spending cap.
AI_DAILY_LIMIT=50
